{
  "name": "magical-mixing-console",
  "productName": "Magical Mixing Console",
  "version": "2.3.0",
  "description": "An app for controlling X Air and M Air digital mixers, with the hope of supporting other mixers in the future.",
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "build-linux": "node installer/linux/build.js",
    "build-windows": "node installer/windows/build.js",
    "build-mac": "node installer/mac/build.js",
    "tinyjs-backend": "esbuild src/console/tinyjs/backend/main.js --bundle --format=esm --platform=neutral --main-fields=module,main \"--external:tjs:*\" --log-level=warning --outfile=out/tinyjs/backend/main.js",
    "tinyjs-frontend-dev": "vite --config vite/tinyjs.config.mjs",
    "tinyjs-frontend-build": "cross-env MMC_ENV=production vite build --config vite/tinyjs.config.mjs",
    "tinyjs-dev": "npm run tinyjs-backend && tinyjs dev",
    "tinyjs-icon": "node -e \"process.platform === 'darwin' && require('child_process').execSync('rm -rf out/tinyjs/icon.iconset && iconutil -c iconset -o out/tinyjs/icon.iconset assets/icon/icon.icns')\"",
    "tinyjs-build": "npm run tinyjs-backend && npm run tinyjs-icon && tinyjs build",
    "cap-android": "npx cap open android",
    "cap-ios": "npx cap open ios",
    "cap-dev": "cross-env MMC_ENV=development vite build --config vite/capacitor.config.mjs && npx cap sync",
    "cap-make": "cross-env MMC_ENV=production vite build --config vite/capacitor.config.mjs && npx cap sync",
    "cap-assets": "npx @capacitor/assets generate --android --iconBackgroundColor \"#ffffff\" --iconBackgroundColorDark \"#000000\" --splashBackgroundColor \"#ffffff\" --splashBackgroundColorDark \"#000000\" --logoSplashScale 0.5",
    "lint": "eslint ./src ./tests",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.mjs"
  },
  "keywords": [
    "digital",
    "mixer",
    "mixing",
    "console",
    "xair",
    "mair",
    "react",
    "capacitor"
  ],
  "author": {
    "name": "Matías Barrios",
    "email": "matias@magicalmixingconsole.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "cssnano": "^9.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.4.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.4.33",
    "postcss-advanced-variables": "^5.0.0",
    "postcss-import": "^17.0.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capacitor/toast": "^8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@magical-mixing/mixers": "^1.0.0",
    "@magical-mixing/mixers-react": "^1.0.0",
    "@magical-mixing/virtual-devices": "^1.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@radix-ui/themes": "^3.2.1",
    "@use-gesture/react": "^10.3.1",
    "@webnativellc/capacitor-navigation-bar": "file:plugins/capacitor-navigation-bar",
    "autoprefixer": "^10.4.21",
    "buffer": "^6.0.3",
    "capacitor-udp-socket": "file:plugins/capacitor-udp-socket",
    "d3": "^7.8.5",
    "lucide-react": "^1.17.0",
    "motion": "^14.9.0",
    "netmask": "^2.0.2",
    "process": "^0.11.10",
    "radix-ui": "^1.2.0",
    "react": "^19.1.0",
    "react-currency-input-field": "^4.0.5",
    "react-dom": "^19.1.0",
    "react-router": "^8.5.1"
  },
  "overrides": {
    "eslint": "$eslint",
    "@eslint/js": "$@eslint/js",
    "xcode": "4.0.0"
  }
}
